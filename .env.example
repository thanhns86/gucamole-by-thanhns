# ============================================================
# Guacamole PostgreSQL Database Configuration
# Copy file này thành .env và thay đổi giá trị cho phù hợp
# ============================================================

# Tên user database
POSTGRES_USER=guacamole

# Mật khẩu database (HÃY ĐỔI THÀNH MẬT KHẨU MẠNH!)
POSTGRES_PASSWORD=YourStrongPassword123!

# Tên database
POSTGRES_DB=guacamole_db
